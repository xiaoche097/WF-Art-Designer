{
  "name": "wf-art-assistant",
  "private": true,
  "version": "2.4.0",
  "displayName": "WF美工助手",
  "description": "WF美工助手 Photoshop UXP panel for RunningHub repair, local cache, decoding, and return-image workflows.",
  "author": "WF美工助手",
  "license": "UNLICENSED",
  "homepage": "about:wf-art-assistant",
  "repository": {
    "type": "local-workspace",
    "directory": "WF美工助手"
  },
  "engines": {
    "node": ">=18"
  },
  "config": {
    "uxp_dist": "dist",
    "plugin_root": "plugin",
    "preset_bundle": "assets/rh-app-bundle.json"
  },
  "keywords": [
    "wf-art-assistant",
    "photoshop-uxp",
    "runninghub",
    "return-image",
    "image-repair"
  ],
  "wfArtAssistant": {
    "productName": "WF美工助手",
    "workspace": "Photoshop UXP",
    "primaryFlow": "RunningHub 回图与本地缓存",
    "maintainer": "WF美工助手",
    "defaultResultCache": "PluginData/image_cache",
    "featureAreas": [
      "RunningHub 应用任务提交",
      "本地回图缓存",
      "小黄鸭解码开关",
      "Photoshop 自动回传"
    ],
    "buildNotes": {
      "distFolder": "dist",
      "selfCheck": "scripts/pluginSelfCheck.cjs",
      "presetBundle": "assets/rh-app-bundle.json"
    }
  },
  "scripts": {
    "build": "node scripts/wfaBuild.cjs development --verify-dist",
    "build:dev": "node scripts/wfaBuild.cjs development --verify-dist",
    "build:prod": "node scripts/wfaBuild.cjs production --verify-dist",
    "build:web": "webpack --mode production --env web",
    "build:icons": "node scripts/build-brand-icons.cjs",
    "watch:web": "webpack --mode development --env web --watch",
    "serve:web": "node scripts/serve-web.cjs",
    "release": "npm run build:prod && node scripts/release-installer/build-public-release.cjs",
    "release:plain": "npm run build:prod && node scripts/release-installer/build-release.cjs",
    "check:plugin": "node scripts/pluginSelfCheck.cjs",
    "watch": "nodemon -w src -w plugin -w scripts -w webpack.config.js -e js,jsx,json,css,html,cjs,mjs -x npm run build:dev",
    "uxp:load": "cd dist && uxp plugin load",
    "uxp:reload": "cd dist && uxp plugin reload",
    "uxp:watch": "cd dist && nodemon --exec \"uxp plugin reload\" -e js,css,html,json",
    "uxp:debug": "cd dist && uxp plugin debug",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/tasks-vision": "0.10.21",
    "jimp": "^1.6.0",
    "marked": "^17.0.5",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "react-sortable-hoc": "^2.0.0",
    "socket.io-client": "^4.8.1",
    "systeminformation": "^5.31.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.7",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/plugin-syntax-class-properties": "^7.10.4",
    "@babel/plugin-transform-react-jsx": "^7.8.3",
    "babel-loader": "^8.0.6",
    "clean-webpack-plugin": "^2.0.2",
    "css-loader": "^6.8.1",
    "file-loader": "^5.1.0",
    "javascript-obfuscator": "^5.4.3",
    "nodemon": "^2.0.7",
    "patch-package": "^8.0.1",
    "style-loader": "^1.1.3",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4"
  },
  "resolutions": {
    "acorn": "npm:acorn-with-stage3"
  }
}
